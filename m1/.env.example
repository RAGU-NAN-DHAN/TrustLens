# Copy to .env (and load it yourself, e.g. `export $(cat .env | xargs)` or
# via python-dotenv in your own entrypoint) — this project never reads a
# .env file automatically, to avoid accidentally bundling secrets.
# Never commit a real .env file.

# Required for generator.py / self_consistency.py
GROQ_API_KEY=gsk_placeholder_do_not_commit_a_real_key

# Optional — defaults shown. Groq no longer serves Llama 3.3 70B (originally
# planned), so the default writer/generator model is openai/gpt-oss-120b.
# Do NOT set this to a Qwen model — Qwen is reserved for M3's second
# verifier, and the generator/verifier must stay different models.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_MAX_RETRIES=2

# Optional — self-consistency sampling (embeddings.py / self_consistency.py)
TRUSTLENS_SC_SAMPLE_COUNT=3
TRUSTLENS_SC_TEMPERATURE=0.9
TRUSTLENS_SC_MAX_OUTPUT_TOKENS=512

# Optional — shared embedding service (embeddings.py)
TRUSTLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRUSTLENS_EMBEDDING_DEVICE=auto
TRUSTLENS_EMBEDDING_BATCH_SIZE=32
