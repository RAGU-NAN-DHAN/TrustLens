# Copy to backend/.env and fill in. Never commit .env or paste keys in chat.
GEMINI_API_KEY=
GROQ_API_KEY=
BRAVE_API_KEY=

GEMINI_VERIFIER_MODEL=gemini-3.5-flash
GEMINI_FLASH_MODEL=gemini-3.5-flash
GROQ_GENERATOR_MODEL=llama-3.3-70b-versatile
# Verifier 2 must NOT be Llama. Pick a current non-Llama model from console.groq.com/docs/models
GROQ_VERIFIER_MODEL=qwen/qwen3.8-27b

# 1 = offline mock verifiers (no keys needed), 0 = real API calls
TRUSTLENS_MOCK=1
TRUSTLENS_HTTP_TIMEOUT=60
DATABASE_URL=sqlite:///./trustlens.db
